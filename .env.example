# Copy this file to ".env" and fill in real values. ".env" itself is
# gitignored — never commit real secrets.
#
# The game starts with Discord login. Fill these values before testing
# locally or deploying.

# ---- Server ----
PORT=8443
# Set to "production" once deployed for real (enables secure cookies —
# requires HTTPS, e.g. behind Cloudflare).
NODE_ENV=development

# ---- MongoDB (player accounts) ----
# MongoDB Atlas free tier connection string, or your own instance.
MONGODB_URI=
MONGODB_DB_NAME=arcane_duel

# ---- Discord OAuth2 (login) ----
# From https://discord.com/developers/applications -> your app -> OAuth2.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered in the Discord app's OAuth2 settings.
DISCORD_REDIRECT_URI=http://localhost:8443/auth/discord/callback
# Extra scopes for Discord OAuth. "identify" is always required and will be
# added automatically if omitted.
DISCORD_OAUTH_SCOPES=identify
# Optional URL used by the main menu's Discord invite/config action.
DISCORD_ACTIVITY_INVITE_URL=

# Optional production origin lock for browser WebSockets. Set this to the
# Activity URL after deployment, for example: https://tcg.warera.wiki
# Leave blank for local development; the server then accepts its current host.
PUBLIC_APP_ORIGIN=
# Optional comma-separated additional trusted origins, normally left blank.
WS_ALLOWED_ORIGINS=
# WebSocket capacity safeguards for the public server.
MAX_WS_CONNECTIONS=200
MAX_WS_SOCKETS_PER_USER=3
MAX_WS_SOCKETS_PER_IP=5

# ---- Sessions ----
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
